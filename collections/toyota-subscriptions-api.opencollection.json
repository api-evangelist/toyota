{
  "opencollection": "1.0.0",
  "info": {
    "name": "Toyota Connected Services Climate Subscriptions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Vehicle Subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.toyota.com/connected/v1/vehicles/:vin/subscriptions",
            "params": [
              {
                "name": "vin",
                "value": "",
                "type": "path",
                "description": "Vehicle Identification Number"
              }
            ]
          },
          "docs": "Returns connected service and satellite radio subscription details for a vehicle."
        }
      ]
    }
  ],
  "bundled": true
}