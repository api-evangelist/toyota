{
  "opencollection": "1.0.0",
  "info": {
    "name": "Toyota Connected Services Climate History API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "History",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Service History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.toyota.com/connected/v1/vehicles/:vin/service-history",
            "params": [
              {
                "name": "vin",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns service history records for the vehicle."
        }
      ]
    }
  ],
  "bundled": true
}